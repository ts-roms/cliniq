{
  "name": "@org/web-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": ["@org/api", "@org/web"],
    "tags": ["scope:web", "type:app"],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "playwright test",
          "cwd": "apps/web-e2e"
        }
      },
      "lint": {
        "executor": "@nx/eslint:lint",
        "options": {
          "lintFilePatterns": ["apps/web-e2e/**/*.{ts,tsx,js,jsx}"]
        }
      }
    }
  }
}
