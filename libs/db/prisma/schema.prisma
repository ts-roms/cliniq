  tenantId         String
  patientId        String
  type             ConsentType
  granted          Boolean
  version          String      @default("v1")
  acceptedAt       DateTime?
  withdrawnAt      DateTime?
  withdrawalReason String?
  recordedBy       String?     // user id of staff who toggled (null = patient self-serve)
  ip               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, patientId, type])
  @@index([tenantId, patientId])
  @@map("patient_consents")
}

enum ConsentType {
  TREATMENT
  AI_PROCESSING
  REMINDERS
  MARKETING
  RESEARCH
}

// ──────────────────────────────────────────────
