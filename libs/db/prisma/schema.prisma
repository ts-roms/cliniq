// ──────────────────────────────────────────────
// BILLING (services, invoices, payments)
// ──────────────────────────────────────────────

model Service {
  id            String  @id @default(cuid())
  tenantId      String
  code          String?
  name          String
  category      String?
  priceCentavos Int
  currency      String  @default("PHP")
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]

  @@index([tenantId, active])
  @@map("services")
}

// ── Visit types (what a patient is coming in FOR) ────────────────
// Distinct from AppointmentType, which is the modality (consult / follow-up /
// procedure / telemed) and says nothing about the clinical domain, and from
// Service, which is a billing price list with no clinical meaning.
//
// A visit type is the clinic's own catalogue of checkups — "Dental cleaning",
// "Prenatal checkup", "Annual physical" — and each one names the clinical
// modules it focuses. Picking one at booking or check-in is what tells the
// consult screen to open the dental chart rather than every form the product
// ships.
//
// `modules` holds ClinicModule ids (libs/shared-types/src/lib/clinic-modules.ts).
// Kept as text[] rather than an enum so adding a module is a code change, not
// a migration; the api validates against the catalogue on write.
model VisitType {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String?
  // Clinical modules this visit focuses. Empty = general visit, no emphasis.
  modules  String[] @default([])
  // Shown first in the picker, and pre-selected for a walk-in.
  isDefault Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  // Free-text guidance shown under the picker.
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  appointments  Appointment[]
  consultations Consultation[]

  @@unique([tenantId, name])
  @@index([tenantId, active, sortOrder])
  @@map("visit_types")
}

model Invoice {
  id               String        @id @default(cuid())
  tenantId         String
  patientId        String
  number           String
  issuedAt         DateTime      @default(now())
  dueAt            DateTime?
  subtotalCentavos Int           @default(0)
  discountCentavos Int           @default(0)
  taxCentavos      Int           @default(0)
  totalCentavos    Int           @default(0)
  paidCentavos     Int           @default(0)
  currency         String        @default("PHP")
  status           InvoiceStatus @default(DRAFT)
  notes            String?
  createdById      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]
  hmoClaims HmoClaim[]

  @@unique([tenantId, number])
  @@index([tenantId, patientId, issuedAt])
  @@index([tenantId, status])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id                String  @id @default(cuid())
  tenantId          String
  invoiceId         String
  serviceId         String?
  description       String
  quantity          Int     @default(1)
  unitPriceCentavos Int
  totalCentavos     Int

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(cuid())
  tenantId       String
  invoiceId      String
  amountCentavos Int
  currency       String        @default("PHP")
  method         PaymentMethod
  reference      String?
  paidAt         DateTime      @default(now())
  status         PaymentStatus @default(SUCCEEDED)
  metadata       Json?

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, paidAt])
  @@index([invoiceId])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  BANK_TRANSFER
  CARD
  HMO
  INSURANCE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ──────────────────────────────────────────────
// DATA SUBJECT REQUESTS (DPA Sec 16)
// ──────────────────────────────────────────────

model DataSubjectRequest {
  id         String    @id @default(cuid())
  tenantId   String
  patientId  String
  type       DsrType
  status     DsrStatus @default(OPEN)
  details    String?
  resolution String?
  filedBy    String?
  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, patientId])
  @@map("dsr_requests")
}

enum DsrType {
  ACCESS
  CORRECTION
  ERASURE
  OBJECTION
  PORTABILITY
}

enum DsrStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// ──────────────────────────────────────────────
// INVENTORY (pharmacy stock + supplies)
// ──────────────────────────────────────────────
//
// Three-table model: catalog (InventoryItem) → batches (StockBatch, lot+expiry)
// → immutable ledger (StockMovement). On-hand qty is derived from
// SUM(batches.remainingQty) so the ledger and balance can never drift.
// FEFO (first-expiry-first-out) is the default dispense order.

model InventoryItem {
  id                   String           @id @default(cuid())
  tenantId             String
  sku                  String
  name                 String
  category             String?
  unit                 String           @default("each")  // tablet, mL, vial, kit, each
  reorderLevel         Int              @default(0)
  defaultPriceCentavos Int              @default(0)
  isControlled         Boolean          @default(false)
  active               Boolean          @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  batches   StockBatch[]
  movements StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId, active, name])
  @@map("inventory_items")
}

model StockBatch {
  id              String    @id @default(cuid())
  tenantId        String
  itemId          String
  lotNumber       String?
  expiresOn       DateTime?
  receivedQty     Int
  remainingQty    Int
  unitCostCentavos Int      @default(0)
  supplierName    String?
  receivedAt      DateTime  @default(now())
  receivedBy      String?

  item      InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  // FEFO indexes — partial: only consider batches with stock left.
  @@index([tenantId, itemId, expiresOn])
  @@index([tenantId, itemId, remainingQty])
  @@map("stock_batches")
}

enum StockMovementKind {
  RECEIVE
  DISPENSE
  ADJUST
  EXPIRE
  RETURN
}

model StockMovement {
  id             String            @id @default(cuid())
  tenantId       String
  itemId         String
  batchId        String?
  kind           StockMovementKind
  quantity       Int               // signed: + receive/return, - dispense/expire/adjust-down
  reason         String?
  prescriptionId String?
  performedBy    String?
  occurredAt     DateTime          @default(now())

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batch StockBatch?   @relation(fields: [batchId], references: [id])

  @@index([tenantId, itemId, occurredAt])
  @@index([tenantId, prescriptionId])
  @@map("stock_movements")
}

// ──────────────────────────────────────────────
// HMO CLAIMS (PH market — Maxicare, Medicard, Intellicare, PhilHealth, …)
// ──────────────────────────────────────────────
//
// Three-table model: catalog (HmoProvider) → patient cards (HmoMembership)
// → submitted claims (HmoClaim). When an HMO approves a claim, recordHmoPayment
// creates a `Payment` row on the linked Invoice with `method=HMO` so the
// existing billing flow recomputes invoice.paidCentavos + status.

model HmoProvider {
  id           String  @id @default(cuid())
  tenantId     String
  name         String
  payerCode    String?  // PhilHealth PHIC code, HMO accreditation no., etc.
  contactPhone String?
  contactEmail String?
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships HmoMembership[]
  claims      HmoClaim[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("hmo_providers")
}

model HmoMembership {
  id          String    @id @default(cuid())
  tenantId    String
  patientId   String
  providerId  String
  memberId    String    // patient's HMO member number / card number
  validFrom   DateTime?
  validUntil  DateTime?
  active      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient  Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider HmoProvider @relation(fields: [providerId], references: [id])
  claims   HmoClaim[]

  @@unique([tenantId, patientId, providerId])
  @@index([tenantId, patientId])
  @@map("hmo_memberships")
}

enum HmoClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIAL
  DENIED
  PAID
  CANCELLED
}

model HmoClaim {
  id                          String         @id @default(cuid())
  tenantId                    String
  invoiceId                   String
  patientId                   String
  providerId                  String
  membershipId                String?
  number                      String         // per-tenant claim number, e.g. CLM-202605-0001
  status                      HmoClaimStatus @default(DRAFT)
  authNumber                  String?        // approval number from the HMO
  claimedCentavos             Int            @default(0)
  approvedCentavos            Int            @default(0)
  patientResponsibilityCentavos Int          @default(0)
  denialReason                String?
  notes                       String?
  submittedAt                 DateTime?
  resolvedAt                  DateTime?
  createdById                 String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patient    Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider   HmoProvider    @relation(fields: [providerId], references: [id])
  membership HmoMembership? @relation(fields: [membershipId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, invoiceId])
  @@index([tenantId, patientId])
  @@map("hmo_claims")
}

// ──────────────────────────────────────────────
// LAB ORDERS + RESULTS
// ──────────────────────────────────────────────
//
// One LabOrder per order slip, multiple LabOrderItems per order (one per
// test). Results are stored inline on the item — for panels that produce
// many values (e.g. CBC), each value gets its own item. Abnormal flags are
// computed at result entry from referenceLow/referenceHigh.

// ──────────────────────────────────────────────
// LABORATORY TEST CATALOGUE
// ──────────────────────────────────────────────
//
// What the laboratory offers, and what each test actually reports.
//
// Before this, an order item carried `testName String` and an optional
// `testCode` — both free text. Three clinics spelled "CBC with platelet
// count" three ways, nothing could be reported on, and a panel had no
// identity at all: the schema's own comment admitted that a CBC was entered
// as ~7 sibling order items with no parent, no shared reference set, and no
// way to render a CBC report AS a CBC.
//
// A panel is a LaboratoryTest whose TestComponents are its analytes. CBC is
// one test with HGB / HCT / RBC / WBC / PLT components, not seven tests.
//
// Deliberately NOT here yet, each its own piece of work:
//   * ReferenceRange  — needs age / sex / method / effective-date dimensions;
//                       components carry a default unit only
//   * Specimen        — accession, collection, reception, rejection
//   * Container / SpecimenType as tables — carried as fields for now, because
//                       two more reference tables buy nothing until specimen
//                       handling exists to consume them

/// A bench. Hematology, Clinical Chemistry, Urinalysis, and so on.
///
/// Tenant-scoped and configurable rather than an enum: DOH licenses a
/// laboratory for a specific service capability, and not every laboratory
/// offers every section. Hard-coding the list would misrepresent what a
/// given lab is licensed to do.
model LabSection {
  id       String @id @default(cuid())
  tenantId String

  code String  // HEMATOLOGY, CLINICAL_CHEMISTRY, …
  name String
  sortOrder Int    @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tests LaboratoryTest[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@map("lab_sections")
}

enum LabResultType {
  NUMERIC
  TEXT
  CODED
  TITER
}

/// One orderable test.
///
/// `code` is the laboratory's own code and is what CriticalValueRule matches
/// on, via the same normalisation the flagging module applies. `loincCode` is
/// carried separately because a local code is what staff type and LOINC is
/// what an interoperability layer needs — conflating them loses one or the
/// other.
model LaboratoryTest {
  id       String @id @default(cuid())
  tenantId String

  code      String  // local code, e.g. "CBC", "K"
  loincCode String?
  name      String
  shortName String?

  sectionId String

  /// True when the test reports several analytes. A CBC is one test with
  /// many components, not many tests.
  isPanel Boolean @default(false)

  // Collection guidance. Fields rather than tables until specimen handling
  // exists to consume them — see the header.
  specimenType           String?  // "Whole blood (EDTA)", "Random urine"
  container              String?  // "Lavender top", "Sterile cup"
  minVolumeMl            Float?
  collectionInstructions String?
  processingInstructions String?

  method String?

  /// Turnaround targets in minutes, for the TAT reporting the audit calls
  /// for. Null means the laboratory has not committed to one.
  targetTatMinutes Int?
  statTatMinutes   Int?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  section    LabSection      @relation(fields: [sectionId], references: [id])
  components TestComponent[]
  orderItems LabOrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId, sectionId, isActive])
  @@map("laboratory_tests")
}

/// One analyte a test reports.
///
/// A non-panel test has exactly one component; a CBC has several. Results
/// will hang off these rather than off a free-text name, which is what makes
/// "show me every haemoglobin for this patient" answerable.
model TestComponent {
  id       String @id @default(cuid())
  tenantId String
  testId   String

  code      String  // HGB, HCT, WBC …
  loincCode String?
  name      String

  resultType LabResultType @default(NUMERIC)
  unit       String?
  /// Decimal places for display. Reporting haemoglobin to four places is
  /// false precision; reporting it to zero loses information.
  decimals   Int  @default(1)

  displayOrder Int @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  test LaboratoryTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([tenantId, testId, code])
  @@index([tenantId, testId, displayOrder])
  @@map("test_components")
}

// ──────────────────────────────────────────────
// SPECIMENS
// ──────────────────────────────────────────────
//
// The accession number is the specimen's identity for the rest of its life:
// it is what goes on the label, the worklist and the report, and it is what
// makes "which tube produced this result" answerable. Before this, a lab
// order carried three nullable timestamps (collectedAt / receivedAt /
// reportedAt) and nothing else — no collector, no container, no volume, no
// rejection, and no way to tell one tube from another when an order needed
// two.

enum SpecimenStatus {
  ORDERED
  COLLECTED
  RECEIVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
  REFERRED
}

/// Why a specimen could not be used.
///
/// A closed list rather than free text because rejection rate by reason is a
/// quality indicator a laboratory is expected to track and act on — "other,
/// see note" for everything makes that impossible.
enum SpecimenRejectionReason {
  HEMOLYZED
  INSUFFICIENT_QUANTITY
  WRONG_CONTAINER
  WRONG_SPECIMEN
  LEAKING
  CLOTTED
  IMPROPER_TRANSPORT
  UNLABELED
  MISLABELED
  DELAYED
  OTHER
}

model Specimen {
  id       String @id @default(cuid())
  tenantId String

  /// Per tenant, per day, allocated atomically. See DocumentSequence.
  accessionNumber String

  orderId   String
  patientId String

  /// Recorded at collection, not joined from the catalogue: the catalogue
  /// can be edited afterwards, and what was actually drawn does not change.
  specimenType String?
  container    String?
  volumeMl     Float?

  collectedAt    DateTime?
  collectedById  String?
  collectionSite String?

  receivedAt   DateTime?
  receivedById String?

  status          SpecimenStatus @default(ORDERED)
  storageLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      LabOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items      LabOrderItem[]
  rejections SpecimenRejection[]

  @@unique([tenantId, accessionNumber])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, orderId])
  @@index([tenantId, patientId, createdAt])
  @@map("specimens")
}

/// A specimen that could not be used, and what was done about it.
///
/// Append-only and one-per-attempt: a tube rejected twice has two rows, and
/// the application role holds no UPDATE or DELETE on this table. A mistaken
/// rejection is explained by the next attempt, not erased.
model SpecimenRejection {
  id       String @id @default(cuid())
  tenantId String

  specimenId String
  reason     SpecimenRejectionReason
  remarks    String?

  rejectedById String
  rejectedAt   DateTime @default(now())

  /// When the ordering team was told. Null means nobody has been told yet,
  /// which is the state a rejection worklist should surface.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  specimen Specimen @relation(fields: [specimenId], references: [id], onDelete: Cascade)

  @@index([tenantId, specimenId])
  @@index([tenantId, reason, rejectedAt])
  @@map("specimen_rejections")
}

/// Gap-free, race-free document numbering.
///
/// The old `nextOrderNumber` did count-then-format inside a transaction:
///
///     const n = await tx.labOrder.count({ where: { number: { startsWith } } });
///     return `${prefix}-${n + 1}`;
///
/// At READ COMMITTED two concurrent orders read the same count and format the
/// same number; the unique index then fails one insert, surfacing as a 500.
/// Accession numbers are allocated far more often than order slips and would
/// hit it routinely.
///
/// Allocation is a single atomic INSERT ... ON CONFLICT DO UPDATE ... RETURNING,
/// so concurrent callers serialise on the row rather than racing.
model DocumentSequence {
  id       String @id @default(cuid())
  tenantId String

  /// What is being numbered: ACCESSION, LAB_ORDER, …
  kind String
  /// The window the counter resets on — "2026-09-24" for a daily accession
  /// series, "2026-09" for a monthly order series. Opaque to the allocator.
  period String

  nextValue Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, kind, period])
  @@map("document_sequences")
}

enum LabOrderStatus {
  PENDING
  COLLECTED
  RECEIVED
  REPORTED
  CANCELLED
}

/// Per-analyte critical limits, configured by the laboratory.
///
/// A critical value is a clinical threshold the lab sets per analyte. It has
/// no arithmetic relationship to the reference interval — potassium's
/// reference top is 5.1 mmol/L and its critical top is ~6.0, not 1.5x
/// anything. Deriving one from the other under-flags results that need a
/// phone call, so limits live here and nowhere else.
///
/// `testKey` is the normalised `testCode ?? testName` of a LabOrderItem (see
/// normaliseTestKey in apps/api/src/labs/flagging.ts). It is a stopgap: when
/// the test catalogue lands, rules hang off a component id instead.
///
/// Rows are never edited in place to change a limit — insert a new row with a
/// later `effectiveFrom` and close the old one with `effectiveTo`, so a result
/// flagged last year can still be explained by the limits in force then.
model CriticalValueRule {
  id       String @id @default(cuid())
  tenantId String

  testKey  String  // normalised match key, e.g. "K" or "POTASSIUM"
  label    String  // what staff see, e.g. "Potassium (serum)"
  unit     String?

  // Optional demographic narrowing. Null on both = applies to any patient.
  // ageMinDays is inclusive, ageMaxDays exclusive. Days, not years, because
  // neonatal limits change week to week.
  ageMinDays Int?
  ageMaxDays Int?
  sex        Sex?

  // At least one of the two must be set — enforced by a CHECK constraint.
  criticalLow  Float?
  criticalHigh Float?

  note String?

  /// How long the responsible clinician has to acknowledge a result that
  /// trips this rule before the escalation sweep picks it up. Per-analyte
  /// because urgency is: a critical potassium wants a phone call inside
  /// minutes, an abnormal TSH does not.
  ///
  /// LabsService reads this when it raises a CriticalResultNotification and
  /// uses it to compute `dueAt`.
  notifyWithinMinutes Int @default(60)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, testKey, effectiveFrom])
  @@map("critical_value_rules")
}

/// How a critical result was communicated to the responsible clinician.
///
/// IN_APP is what the system can do by itself. The others record a human
/// action — a laboratory that telephones a critical potassium logs PHONE with
/// the read-back in `acknowledgementNote`. Documented communication AND
/// acknowledgement of critical values is the single most common finding in
/// laboratory inspections, and neither can be evidenced from an in-app
/// notification that nobody opened.
enum CriticalNotificationMethod {
  IN_APP
  PHONE
  SMS
  EMAIL
  IN_PERSON
}

/// A critical result that someone must be told about, and the record that
/// they were.
///
/// Before this existed, a critical result fired a fire-and-forget in-app
/// notification:
///
///     void this.notif.notify({ ... severity: CRITICAL ... });
///
/// unawaited, failure swallowed, no recipient record, no acknowledgement, no
/// escalation, and no audit row. If delivery failed there was no trace that
/// anyone should have been told — the result simply sat in the chart.
///
/// The row is now written in the SAME transaction as the result, so a
/// critical value cannot exist without a corresponding obligation to
/// communicate it. Delivery stays best-effort and is recorded on the row;
/// the obligation does not depend on delivery succeeding.
///
/// Values are snapshotted rather than joined: the row has to stay meaningful
/// after a result is corrected, and "what was critical at the time" is the
/// question an inspection asks.
model CriticalResultNotification {
  id       String @id @default(cuid())
  tenantId String

  orderId     String
  orderItemId String
  patientId   String

  // Snapshot of what made this critical.
  testName     String
  resultValue  String
  resultUnit   String?
  flag         LabAbnormalFlag
  criticalLow  Float?
  criticalHigh Float?
  /// The rule that fired, when one did. Null for an explicitly-flagged result.
  ruleId       String?

  /// The clinician who must be told — the ordering provider.
  recipientUserId String
  method          CriticalNotificationMethod @default(IN_APP)

  /// When delivery was attempted and whether it worked. A null notifiedAt
  /// with a non-null deliveryError is the case that used to be invisible.
  notifiedAt    DateTime?
  deliveryError String?

  /// Read-back. `acknowledgementNote` is where the clinician's repeat-back of
  /// the value goes when the lab telephones it.
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  acknowledgementNote  String?

  /// When acknowledgement becomes overdue, from the rule's
  /// notifyWithinMinutes. The escalation sweep reads this.
  dueAt       DateTime
  escalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, acknowledgedAt, dueAt])
  @@index([tenantId, orderItemId])
  @@index([tenantId, patientId, createdAt])
  @@map("critical_result_notifications")
}

enum LabAbnormalFlag {
  NORMAL
  HIGH
  LOW
  CRITICAL_HIGH
  CRITICAL_LOW
  ABNORMAL
}

model LabOrder {
  id             String         @id @default(cuid())
  tenantId       String
  consultationId String?
  patientId      String
  providerId     String
  number         String         // per-tenant slip number, e.g. LAB-202605-0001
  vendor         String?        // e.g. "Hi-Precision", "Makati Med Lab", in-house
  externalRef    String?        // lab's own reference number
  status         LabOrderStatus @default(PENDING)
  notes          String?

  collectedAt DateTime?
  receivedAt  DateTime?
  reportedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation?  @relation(fields: [consultationId], references: [id])
  items        LabOrderItem[]
  specimens    Specimen[]
  reports      LabReport[]

  @@unique([tenantId, number])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, consultationId])
  @@map("lab_orders")
}

model LabOrderItem {
  id             String           @id @default(cuid())
  tenantId       String
  orderId        String
  /// Catalogue entry this item was ordered from, when it was. Nullable: rows
  /// written before the catalogue existed have none, and a laboratory may
  /// still order something ad hoc. When set, the name/code/unit below are a
  /// SNAPSHOT of the catalogue at order time — the catalogue can be edited
  /// and a historical order must still read as it was placed.
  testId         String?
  testCode       String?          // e.g. LOINC or local code
  testName       String
  category       String?          // CBC, Chem, Urinalysis, Imaging, …
  resultValue    String?          // free-form: numbers, "Negative", "Reactive"
  resultUnit     String?
  referenceLow   Float?
  referenceHigh  Float?
  // Per-order override of the tenant's CriticalValueRule for this test. Set
  // these only when THIS order needs limits different from the configured
  // ones; leave null and the rule applies. Critical limits are NEVER derived
  // from referenceLow/referenceHigh — see apps/api/src/labs/flagging.ts.
  criticalLow    Float?
  criticalHigh   Float?
  abnormalFlag   LabAbnormalFlag?
  comment        String?
  reportedAt     DateTime?

  /// Where this result is in the verification chain. PENDING until a value
  /// is keyed in; PRELIMINARY once it is but before anyone has released it;
  /// FINAL once released; CORRECTED if a released value was later changed.
  /// The vocabulary is HL7's (P/F/C) because that is what a laboratory
  /// already reads it as.
  ///
  /// A clinic that has not turned verification on never sees PRELIMINARY:
  /// recording a result both enters and releases it, and both stamps below
  /// are set to the same person. That is recorded honestly rather than left
  /// blank, so "who released this" always has an answer.
  resultStatus LabResultStatus @default(PENDING)

  enteredById  String?
  enteredAt    DateTime?
  verifiedById String?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The tube this test is run from. Null until collection, and an order
  /// that needs two specimen types produces two specimens with the items
  /// split between them.
  specimenId String?

  order    LabOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test     LaboratoryTest? @relation(fields: [testId], references: [id])
  specimen Specimen?      @relation(fields: [specimenId], references: [id])
  versions LabResultVersion[]

  @@index([tenantId, orderId])
  @@index([tenantId, testId])
  @@index([tenantId, specimenId])
  @@index([tenantId, resultStatus])
  @@map("lab_order_items")
}

/// HL7 result status. PRELIMINARY means "a value exists but nobody has
/// released it"; FINAL means a qualified person put their name to it.
enum LabResultStatus {
  PENDING
  PRELIMINARY
  FINAL
  CORRECTED
}

/// Every value a result has ever held.
///
/// `recordResult` used to overwrite `LabOrderItem.resultValue` in place, so
/// correcting a result destroyed the one a clinician may already have acted
/// on. There was no way to answer "what did the chart say on Tuesday". Each
/// entry, release and correction now appends a row here; the item carries
/// the current value and this carries the history.
///
/// Append-only at the database level: the application role holds no UPDATE
/// or DELETE. A wrong entry is superseded by the next version, never edited.
model LabResultVersion {
  id       String @id @default(cuid())
  tenantId String

  orderItemId String
  /// 1-based, dense, per item. Allocated inside the same transaction as the
  /// write, under a unique constraint, so two concurrent corrections cannot
  /// both claim the same version.
  version Int

  resultValue  String?
  resultUnit   String?
  abnormalFlag LabAbnormalFlag?
  comment      String?
  /// The status this version put the result INTO, so the history reads as a
  /// sequence of acts (entered, released, corrected) rather than values.
  status LabResultStatus

  /// Why a released result was changed. Required for CORRECTED and null
  /// otherwise — a correction with no stated reason is not reviewable.
  reason String?

  recordedById String
  recordedAt   DateTime @default(now())

  item LabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderItemId, version])
  @@index([tenantId, orderItemId, recordedAt])
  @@map("lab_result_versions")
}

/// Where a report is in its life. There is no DRAFT: a report is created by
/// the act of issuing it, because an unsigned lab report is not a document,
/// it is a query.
enum LabReportStatus {
  ISSUED
  SUPERSEDED
}

/// A signed laboratory report — the artifact that leaves the building.
///
/// Verified results had nowhere to go: there was no report, no signature and
/// no PDF, so a laboratory could release a result and still not issue
/// anything a patient or a referring doctor could hold.
///
/// The hard part is not producing the document, it is keeping it honest
/// after results change. A report signed on Tuesday asserts what the results
/// said on Tuesday; if one is corrected on Wednesday the report is not out
/// of date, it is a signed document stating something untrue, and nothing in
/// the row itself would reveal that. `contentHash` is taken over exactly the
/// values reported, so recomputing it against the current results answers
/// "is this still what was signed?" — see apps/api/src/labs/reporting.ts.
///
/// A stale report is never edited. It is SUPERSEDED by a new version, because
/// it was genuinely issued and someone may be holding a copy.
model LabReport {
  id        String @id @default(cuid())
  tenantId  String
  orderId   String
  patientId String

  /// Per tenant, per month: LR-202609-0001. Allocated atomically through the
  /// same DocumentSequence the accession and order numbers use.
  number String
  /// 1 for the first report on an order, incrementing for each re-issue.
  version Int             @default(1)
  status  LabReportStatus @default(ISSUED)

  /// SHA-256 over the released results this report was built from.
  contentHash String

  issuedAt   DateTime @default(now())
  issuedById String

  /// The report this one replaces. Set on the NEW report, so the chain reads
  /// forwards from any version.
  supersedesId String?    @unique
  supersedes   LabReport? @relation("LabReportChain", fields: [supersedesId], references: [id])
  supersededBy LabReport? @relation("LabReportChain")

  order      LabOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  signatures LabReportSignature[]

  @@unique([tenantId, number])
  /// Unique, not just indexed: two reports on one order cannot share a
  /// version number, or the supersede chain has no defined order.
  @@unique([tenantId, orderId, version])
  @@index([tenantId, patientId, issuedAt])
  @@map("lab_reports")
}

/// Who put their name to a report, and to exactly what.
///
/// The PRC licence is snapshotted at signing time for the same reason
/// `Prescription.providerLicense` is: a later edit to the user's licence
/// details must not retroactively change what appears on a signed document.
///
/// `contentHash` is repeated here rather than read through the report,
/// because what matters is what THIS signer saw. On a re-issued report the
/// two agree; keeping the column makes that an assertion rather than an
/// assumption.
///
/// Append-only: the application role holds no UPDATE or DELETE. A signature
/// withdrawn is a superseded report, not a deleted row.
model LabReportSignature {
  id       String @id @default(cuid())
  tenantId String
  reportId String

  signerId String
  /// The role the signer held when they signed — a pathologist who later
  /// becomes an owner still signed as a pathologist.
  signerRole Role

  signerName    String
  signerLicense String?

  contentHash String
  signedAt    DateTime @default(now())

  report LabReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// One signature per person per report. Signing twice is a no-op, not a
  /// second endorsement.
  @@unique([tenantId, reportId, signerId])
  @@index([tenantId, reportId, signedAt])
  @@map("lab_report_signatures")
}

// ──────────────────────────────────────────────
// TELEMEDICINE (WebRTC peer-to-peer)
// ──────────────────────────────────────────────
//
// 1:1 doctor↔patient sessions. Media flows P2P over a public TURN server
// (env-configured); we only relay signaling (offer/answer/ICE) via short-poll
// HTTP — no WebSocket infra needed for MVP. Patient joins via a one-shot
// joinToken so they don't need a portal account.

enum TeleSessionStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

enum TeleSignalKind {
  OFFER
  ANSWER
  ICE
  JOIN
  LEAVE
  CHAT
  CONSENT_REQUEST   // doctor → patient: "may I record this session?"
  CONSENT_RESPONSE  // patient → doctor: { granted: boolean }
}

enum TeleRole {
  DOCTOR
  PATIENT
}

model TeleSession {
  id             String            @id @default(cuid())
  tenantId       String
  appointmentId  String?
  consultationId String?
  patientId      String
  providerId     String
  joinToken      String            // shared with patient via link
  patientToken   String            // bearer for /tele/* signaling after exchange
  status         TeleSessionStatus @default(PENDING)
  startedAt      DateTime?
  endedAt        DateTime?
  // Consent ledger for in-call recording. Both fields stay null when the
  // doctor never asked; recordingConsentAt is set when the patient grants;
  // recordingDeclinedAt is set when refused. Once a recording is uploaded,
  // recordingFileId points at a FileObject. (Recording upload itself is
  // deferred — schema first so the consent flow can ship without ambiguity.)
  recordingConsentAt   DateTime?
  recordingDeclinedAt  DateTime?
  recordingFileId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  signals     TeleSignal[]

  @@unique([tenantId, joinToken])
  @@index([tenantId, status])
  @@index([tenantId, providerId])
  @@map("tele_sessions")
}

model TeleSignal {
  id        String         @id @default(cuid())
  tenantId  String
  sessionId String
  seq       Int
  fromRole  TeleRole
  kind      TeleSignalKind
  payload   Json
  createdAt DateTime       @default(now())

  session TeleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([sessionId, createdAt])
  @@map("tele_signals")
}

// ──────────────────────────────────────────────
// IN-APP NOTIFICATIONS
// ──────────────────────────────────────────────
//
// Per-user, per-tenant feed. Other services call NotificationsService.notify()
// for async events (HMO claim resolved, lab abnormal, low stock, DSR filed,
// reminder fired). Email/SMS remain separate channels — Notification is the
// in-app surface. Severity drives bell badge color.

enum NotificationKind {
  APPOINTMENT_REMINDER
  HMO_CLAIM_UPDATE
  LAB_REPORTED
  LAB_ABNORMAL
  LAB_CRITICAL_UNACKNOWLEDGED
  INVENTORY_LOW
  DSR_FILED
  DSR_RESOLVED
  AI_BUDGET_ALERT
  GENERAL
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id        String               @id @default(cuid())
  tenantId  String
  userId    String               // recipient
  kind      NotificationKind
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String?
  link      String?              // optional in-app link, e.g. /admin/claims#<id>
  entityId  String?              // optional FK-shaped pointer (no DB constraint)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([tenantId, userId, readAt, createdAt])
  @@index([tenantId, userId, kind])
  @@map("notifications")
}

// Expo push tokens registered by mobile clients. One row per (user, deviceId)
// — the device id is generated on the client (or derived from Expo's
// installation id) and lets a single user have multiple devices. Tokens are
// dedup'd by (token) globally so a re-install with the same token (Expo can
// re-issue) doesn't accumulate stale rows. Replaced wholesale on each login.
model PushToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  deviceId  String
  token     String   @unique
  platform  String   // 'ios' | 'android' | 'web' | 'unknown'
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([tenantId, userId])
  @@map("push_tokens")
}

// ── Dental / Odontogram ───────────────────────────────────────
// Per-consultation snapshot of the patient's dental chart. A patient can have
// many charts over time; the latest one (by createdAt) is the "current" view.
// Tooth codes use FDI/ISO numbering (11–48 adult permanent, 51–85 deciduous).

enum Dentition {
  ADULT
  DECIDUOUS
  MIXED
}

enum ToothStatus {
  PRESENT
  MISSING
  EXTRACTED
  IMPLANT
  CROWNED
  ROOT_CANAL
  EXTRACTION_NEEDED
  UNERUPTED
}

enum ToothSurface {
  M  // mesial
  O  // occlusal/incisal
  D  // distal
  B  // buccal/facial/labial
  L  // lingual/palatal
}

enum SurfaceFinding {
  CARIES
  RESTORATION_AMALGAM
  RESTORATION_COMPOSITE
  SEALANT
  FRACTURE
  WEAR
}

model DentalChart {
  id             String     @id @default(cuid())
  tenantId       String
  patientId      String
  consultationId String?
  dentition      Dentition  @default(ADULT)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  teeth        DentalToothEntry[]

  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, consultationId])
  @@map("dental_charts")
}

model DentalToothEntry {
  id        String      @id @default(cuid())
  tenantId  String
  chartId   String
  toothCode String      // FDI: "11"-"48" adult, "51"-"85" deciduous
  status    ToothStatus @default(PRESENT)
  notes     String?

  chart    DentalChart            @relation(fields: [chartId], references: [id], onDelete: Cascade)
  surfaces DentalSurfaceFinding[]

  @@unique([chartId, toothCode])
  @@index([tenantId, chartId])
  @@map("dental_tooth_entries")
}

model DentalSurfaceFinding {
  id           String         @id @default(cuid())
  tenantId     String
  toothEntryId String
  surface      ToothSurface
  finding      SurfaceFinding
  notes        String?

  toothEntry DentalToothEntry @relation(fields: [toothEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId, toothEntryId])
  @@map("dental_surface_findings")
}

// ── Delegations / acting-as ──────────────────────────────────
// A doctor (delegator) can grant temporary authority to an assistant
// (delegatee) to act on their behalf within [startsAt, endsAt]. Permission
// checks at runtime override the delegatee's role with the delegator's role
// when the request carries a valid X-Acting-For: <delegatorId> header.
//
// Audit trail records both userId (the actual person) and onBehalfOfUserId
// (the delegator) on every action — so the history reads
// "Maria signed Rx as Dr. Cruz at 14:32".

model Delegation {
  id           String           @id @default(cuid())
  tenantId     String
  delegatorId  String           // the doctor granting authority
  delegateeId  String           // the assistant/secretary receiving it
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  // Empty array = full proxy (delegatee inherits all of the delegator's
  // role permissions). Otherwise: list of Action strings (e.g. "rx:sign")
  // that filters which @Requires() actions are honored under delegation.
  scope        String[]         @default([])
  status       DelegationStatus @default(ACTIVE)
  revokedAt    DateTime?
  revokedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delegator User @relation("DelegationGranter", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegatee User @relation("DelegationGrantee", fields: [delegateeId], references: [id], onDelete: Cascade)

  @@index([tenantId, delegateeId, status, startsAt, endsAt])
  @@index([tenantId, delegatorId, status])
  @@map("delegations")
}

enum DelegationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ── Drug catalog (global, optionally tenant-overridable) ────────────────
// Seeded with common PH drugs (generic + brand). Free-text Rx still permitted
// (drugId is optional) so unusual prescriptions aren't blocked, but the
// autocomplete experience should always start from the catalog.

model Drug {
  id           String     @id @default(cuid())
  // Null tenantId = global / built-in. Non-null = tenant override or custom
  // entry. Lookup query filters: WHERE tenantId IS NULL OR tenantId = :current.
  tenantId     String?
  // Generic INN-style name. "amoxicillin", "paracetamol".
  generic      String
  // Optional brand name. "Amoxil", "Biogesic".
  brand        String?
  // Strength as a string ("500 mg", "250 mg/5 ml") so we don't lose unit
  // semantics. Validation lives in the form.
  strength     String?
  // Dosage form (TAB, CAP, SYRUP, DROPS, etc.). Open string to keep flexible.
  form         String?
  // ATC code if known — anatomical-therapeutic-chemical, used for grouping
  // and interaction checks once we wire those.
  atcCode      String?
  // RxNorm CUI if mapped. Optional, but useful for future interop.
  rxnormCode   String?
  // Free-text classes (e.g. "penicillin", "NSAID") — used for allergy
  // matching at prescribe time when we don't have full ATC coverage.
  classes      String[]   @default([])
  // Whether this is a controlled / dangerous-drug class. UI shows a banner.
  controlled   Boolean    @default(false)
  active       Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptionItems PrescriptionItem[]

  // pg_trgm index defined in migration SQL (Prisma can't express it).
  @@index([tenantId, generic])
  @@index([tenantId, brand])
  @@map("drugs")
}

// ── ICD-10 catalog (global, read-only seed) ─────────────────────────────
// Seeded with WHO ICD-10 codes (subset relevant to PH OPD). Used by the
// consultation diagnosis autocomplete and validated on save.

model IcdCode {
  // The ICD-10 code itself ("J06.9", "I10", etc.) is the natural primary
  // key — no separate id needed, codes are stable.
  code        String   @id
  description String
  // Top-level chapter ("X — Diseases of the respiratory system"). Used for
  // grouping in the UI.
  chapter     String?
  // Whether the code is a "billable" leaf node (vs an aggregate parent).
  // PhilHealth eClaims only accept billable leaves.
  billable    Boolean  @default(true)

  @@index([description])
  @@map("icd_codes")
}

// ── Locations (clinic branches) ─────────────────────────────────────────
// A clinic may operate one or more physical/virtual locations. Most v1
// tenants will have exactly one. Multi-branch UI surfaces this when count > 1.

model Location {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  addressLine1 String?
  addressLine2 String?
  city      String?
  province  String?
  postalCode String?
  country   String   @default("PH")
  phone     String?
  // The "primary" location is the default selected in the UI and the one
  // printed on Rx/invoice headers when no per-location override is set.
  isPrimary Boolean  @default(false)
  active    Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isPrimary])
  @@map("locations")
}
