// ──────────────────────────────────────────────
// USERS & RBAC
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  passwordHash  String?
  // Provider credentials — required for valid e-prescriptions in PH (PRC =
  // Professional Regulation Commission). Captured per-user; included on the
  // Rx PDF and snapshotted on the Prescription row at issue time.
  prcLicenseNumber  String?
  prcLicenseExpiry  DateTime?
  prcSpecialty      String?
  signatureFileId   String?  // FileObject id for signature image (PNG, transparent bg)

  // MFA — TOTP. `mfaSecret` is the base32 seed shared with the authenticator
  // app; null = not enrolled. `mfaEnabled` is the explicit flag the login
  // path checks (so we can require re-confirmation on enrollment).
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  // Hashed (bcrypt) one-time backup codes. Each entry is consumed on use.
  mfaBackupCodes String[] @default([])

  lastLogin     DateTime?

  // Brute-force lockout. Incremented on every failed password check, reset
  // to 0 on success. Once it hits AUTH_LOCKOUT_THRESHOLD the login path
  // sets `lockedUntil` and refuses attempts until it passes.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenants       TenantUser[]
  sentInvites   TenantInvite[]        @relation("InviteSender")
  refreshSessions RefreshSession[]
  passwordResets  PasswordResetToken[]
  consultations Consultation[] @relation("ConsultProvider")
  prescriptions Prescription[] @relation("RxProvider")
  appointments  Appointment[]  @relation("ApptProvider")
  availability  ProviderAvailability[]
  timeOff       ProviderTimeOff[]
  amendments          ConsultationAmendment[] @relation("AmendmentAuthor")
  delegationsGranted  Delegation[] @relation("DelegationGranter")
  delegationsReceived Delegation[] @relation("DelegationGrantee")

  @@index([email])
  @@map("users")
}

model TenantUser {
  id        String       @id @default(cuid())
  tenantId  String
  userId    String
  role      Role
  status    MemberStatus @default(ACTIVE)
  // For role=PATIENT only — links the portal account to its Patient record so
  // self-scoped /api/me/* controllers can derive the patient context from JWT
  // alone (no client-supplied patientId; can't impersonate other patients).
  patientId String?
  joinedAt  DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@unique([tenantId, patientId])
  @@index([tenantId, role])
  @@map("tenant_users")
}

// Platform operators — SaaS-side admins managing tenants, billing, support.
// Deliberately NOT a User row: separate identity table = blast-radius
// isolation, distinct auth surface (separate login URL, stricter MFA), no
// tenant coupling, cleaner audit stream. See seed-dev.ts for bootstrap.
model PlatformAdmin {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  mfaBackupCodes String[]  @default([])
  lastLogin      DateTime?

  // Same brute-force treatment as User. These accounts can change any
  // tenant's plan and status, so leaving them on an ip-keyed throttle alone
  // was the weakest control on the strongest credential in the system.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshSessions PlatformRefreshSession[]

  @@index([email])
  @@map("platform_admins")
}

// Platform-side mirror of RefreshSession. Without it a platform refresh token
// was a bare JWT: valid for its full TTL, unrevocable, and `logout` only
// cleared the cookie client-side — so a captured token kept minting access
// tokens for a week after the operator thought they had signed out.
model PlatformRefreshSession {
  id           String    @id @default(cuid())
  adminId      String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  // Set when this session was rotated. Re-presenting a token that already has
  // a successor is a replay: the whole family is revoked.
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("platform_refresh_sessions")
}

enum Role {
  OWNER
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PATIENT
  // Appended, not inserted: ALTER TYPE ADD VALUE puts new labels at the end
  // of the Postgres enum, and listing them in a different order here reads as
  // drift on every `prisma migrate diff`.
  MEDICAL_TECHNOLOGIST
  PATHOLOGIST
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Staff invitation. The ONLY way to join an existing tenant — /auth/register
// requires a valid invite token (or the one-shot bootstrap token issued by
// POST /tenants for the first owner). We store a sha256 of the opaque token,
// never the token itself; the raw token only ever lives in the invite email
// and the inviter's response body.
model TenantInvite {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  role            Role
  tokenHash       String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("tenant_invites")
}

// Server-side refresh-token state. Every refresh JWT carries `sid` = this
// row's id. Refresh rotates the row (revokes the old, inserts a new one
// linked via replacedById); presenting an already-rotated token is treated
// as theft and revokes the whole user+tenant family. Logout / member
// suspension / password reset revoke rows so the 7-day refresh window can
// be cut short server-side.
model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  tenantId     String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// Forgot-password flow. Single-use, short-lived (AUTH_RESET_TTL_MIN).
// Hash-only storage, same reasoning as TenantInvite.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ──────────────────────────────────────────────
// PATIENTS (stub — expand from docs/05)
// ──────────────────────────────────────────────

model Patient {
  id          String   @id @default(cuid())
  tenantId    String
  mrn         String
  firstName   String
  lastName    String
  dateOfBirth DateTime
  sex         Sex
  email       String?
  phone       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultations  Consultation[]
  prescriptions  Prescription[]
  appointments   Appointment[]
  vitals         Vital[]
  allergies      Allergy[]
  medications    Medication[]
  conditions     Condition[]
  invoices       Invoice[]
  dsrRequests    DataSubjectRequest[]
  queueTickets   QueueTicket[]      @relation("PatientQueueTickets")
  pregnancies    ObPregnancy[]      @relation("PatientPregnancies")
  ultrasounds    UltrasoundReport[] @relation("PatientUltrasounds")
  portalAccounts TenantUser[]
  hmoMemberships HmoMembership[]
  hmoClaims      HmoClaim[]
  labOrders      LabOrder[]
  teleSessions   TeleSession[]
  dentalCharts   DentalChart[]

  @@unique([tenantId, mrn])
  @@index([tenantId, lastName, firstName])
  @@map("patients")
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

// ──────────────────────────────────────────────
// CONSULTATIONS (encounters)
// ──────────────────────────────────────────────

model Consultation {
  id          String   @id @default(cuid())
  tenantId   String
  patientId  String
  providerId String   // user.id of the doctor
  // Optional back-link to the booked slot. Walk-ins / ad-hoc consults leave it null.
  appointmentId String? @unique
  // What this consult is for. Copied from the appointment when one opened it,
  // set directly for a walk-in. Drives which clinical forms the consult screen
  // puts in front of the clinician.
  visitTypeId   String?
  startedAt  DateTime @default(now())
  endedAt    DateTime?

  // SOAP — JSON to allow rich text (Tiptap doc) without extra tables in MVP
  subjective Json?
  objective  Json?
  assessment Json?
  plan       Json?

  diagnosisCodes String[] @default([])    // ICD-10
  status         ConsultStatus @default(IN_PROGRESS)
  lockedAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider      User           @relation("ConsultProvider", fields: [providerId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  visitType     VisitType?     @relation(fields: [visitTypeId], references: [id], onDelete: SetNull)
  suggestions   AiSuggestion[]
  amendments    ConsultationAmendment[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  dentalCharts  DentalChart[]

  @@index([tenantId, patientId, startedAt])
  @@index([tenantId, providerId, startedAt])
  @@map("consultations")
}

/// An amendment to a signed consultation.
///
/// Completing a consultation sets `lockedAt` and freezes it: the note is a
/// medico-legal record, so destructive editing is not on the table. But a
/// clinician who signs with the wrong diagnosis or a typo'd dose must have a
/// lawful way to correct it — `ConsultationsService.update` has always told
/// them to "create a revision instead" while no revision mechanism existed,
/// so in practice the workaround was to never complete a consult at all,
/// which quietly destroys the lock's value.
///
/// Each row is a COMPLETE snapshot of the note as amended, not a patch, so
/// "the note as of version N" is one row with no reconstruction. The original
/// `Consultation` row is never rewritten; version 1 here is the first
/// correction to it. The current view is the highest version, falling back to
/// the consultation itself.
///
/// `reason` is required. An amendment without one is unreviewable.
model ConsultationAmendment {
  id             String @id @default(cuid())
  tenantId       String
  consultationId String
  /// 1 = first amendment to the signed note. Unique per consultation.
  version        Int
  /// Who made the correction — not necessarily the original provider.
  authorId       String
  /// Snapshotted at amendment time so a later change to the user's name or
  /// licence does not retroactively alter what was signed. Same reason
  /// Prescription carries providerName / providerLicense.
  authorName     String?
  authorLicense  String?
  reason         String

  subjective     Json?
  objective      Json?
  assessment     Json?
  plan           Json?
  diagnosisCodes String[] @default([])

  signedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  author       User         @relation("AmendmentAuthor", fields: [authorId], references: [id])

  @@unique([consultationId, version])
  @@index([tenantId, consultationId])
  @@map("consultation_amendments")
}

enum ConsultStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model AiSuggestion {
  id             String   @id @default(cuid())
  tenantId       String
  consultationId String
  kind           AiSuggestionKind
  promptVersion  String
  model          String
  draftJson      Json
  status         AiSuggestionStatus @default(PENDING)
  acceptedAt     DateTime?
  acceptedBy     String?
  editDistance   Int?

  createdAt DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([tenantId, consultationId, kind])
  @@map("ai_suggestions")
}

enum AiSuggestionKind {
  SOAP_DRAFT
  TRIAGE
  INTERACTION_CHECK
  DERM_DIFFERENTIAL
  SUMMARY
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  EDITED_ACCEPTED
  REJECTED
}

// ──────────────────────────────────────────────
// PRESCRIPTIONS
// ──────────────────────────────────────────────

model Prescription {
  id             String   @id @default(cuid())
  tenantId       String
  patientId      String
  providerId     String
  consultationId String?

  number     String
  issuedAt   DateTime @default(now())
  validUntil DateTime?
  status     RxStatus @default(ISSUED)
  notes      String?

  // Provider credentials snapshotted at issue time so a later edit to the
  // user's PRC info (rotation, expiry update) doesn't retroactively change
  // what was on a signed Rx. Source of truth on legal artifacts.
  providerName     String?
  providerLicense  String?
  providerSpecialty String?

  pdfUrl     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider     User               @relation("RxProvider", fields: [providerId], references: [id])
  consultation Consultation?      @relation(fields: [consultationId], references: [id])
  items        PrescriptionItem[]

  @@unique([tenantId, number])
  @@index([tenantId, patientId, issuedAt])
  @@map("prescriptions")
}

enum RxStatus {
  ISSUED
  DISPENSED
  CANCELLED
}

model PrescriptionItem {
  id             String   @id @default(cuid())
  tenantId       String
  prescriptionId String

  // Optional reference into the global Drug catalog. When set, the snapshot
  // fields below are populated from the catalog at issue time but are still
  // stored explicitly so historical Rx don't drift if the catalog updates.
  drugId       String?

  drugName     String
  strength     String?
  form         String?  // tab, syrup, drops
  dose         String   // "1 tab"
  frequency    String   // "BID"
  durationDays Int?
  quantity     String?
  instructions String?
  refills      Int      @default(0)

  createdAt DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug         Drug?        @relation(fields: [drugId], references: [id])

  @@index([tenantId, prescriptionId])
  @@index([drugId])
  @@map("prescription_items")
}

// ──────────────────────────────────────────────
// AUDIT LOG
// ──────────────────────────────────────────────

model AuditLog {
  id               String   @id @default(cuid())
  tenantId         String?  // null only for system-level events (e.g. tenant create)
  userId           String?
  // When the actor was operating under a delegation, this is the user whose
  // authority they were exercising. The trail reads as "userId acted on behalf
  // of onBehalfOfUserId at <occurredAt>".
  onBehalfOfUserId String?
  actorEmail       String?  // captured at event time so user deletes don't blank it
  action           String   // dot-namespaced, e.g. "patient.create", "rx.sign"
  entityType       String?
  entityId         String?
  ip               String?
  userAgent        String?
  metadata         Json?
  occurredAt       DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([onBehalfOfUserId])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// FILES
// ──────────────────────────────────────────────

model FileObject {
  id         String       @id @default(cuid())
  tenantId   String
  s3Key      String       @unique
  filename   String
  mimeType   String
  sizeBytes  Int          @default(0)
  category   FileCategory
  isPhi      Boolean      @default(true)
  uploadedBy String?
  status     FileStatus   @default(PENDING)

  /// Who the file is ABOUT. Nullable because not every file has a patient —
  /// a clinic logo, a clinician's signature image — and because rows written
  /// before ownership existed cannot have it inferred after the fact.
  ///
  /// This is the column download authorization hangs off. Without it the only
  /// question answerable about a file was "is it in your tenant?", which is
  /// not enough: it would let any portal account fetch any other patient's
  /// documents. A file with a null patientId is staff-only by construction —
  /// a portal caller can never match null.
  patientId      String?
  /// The encounter it was captured during, when there was one.
  consultationId String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([tenantId, category, createdAt])
  @@index([tenantId, patientId, createdAt])
  @@map("files")
}

enum FileCategory {
  PATIENT_DOC
  CONSULT_ATTACHMENT
  CONSULT_AUDIO
  RX_PDF
  INVOICE_PDF
  RECEIPT_PDF
  AVATAR
  CLINIC_LOGO
  SIGNATURE
  OTHER
}

enum FileStatus {
  PENDING   // presign issued, upload not yet confirmed
  READY     // upload confirmed
  DELETED
}

// ──────────────────────────────────────────────
// CONSENT (DPA + NPC Advisory 2024-04 — AI processing)
// ──────────────────────────────────────────────

model PatientConsent {
