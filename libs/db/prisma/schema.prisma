// ClinIQ — multi-tenant clinic management system
// Full schema lives in docs/05-data-model-prisma.md.
// This starter defines the tenancy primitives + a Patient stub so the workspace boots.
// Expand model-by-model from the docs as you implement each feature slice.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, pg_trgm, btree_gist]
}

// ──────────────────────────────────────────────
// TENANCY
// ──────────────────────────────────────────────

model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  // Top-level discriminator. CLINIC tenants use `type`/`plan`; LAB tenants
  // use `labSpecialty`/`labPlan`. Each side ignores the other's fields.
  // See docs/lab-module-plan.md for the rationale.
  kind        TenantKind   @default(CLINIC)
  type        ClinicType   @default(GENERAL)
  labSpecialty DentalLabSpecialty?
  status      TenantStatus @default(TRIAL)
  // Clinic-side subscription. Null on LAB tenants.
  plan        Plan?        @default(STARTER)
  // Lab-side subscription. Null on CLINIC tenants.
  labPlan     DentalLabPlan?
  country     String       @default("PH")
  timezone    String       @default("Asia/Manila")
  currency    String       @default("PHP")
  trialEndsAt DateTime?
  // Free-form settings: branding (primaryColor, logoUrl), operating hours,
  // payment methods accepted, default invoice notes, tax config. Schema is
  // validated in TenantSettingsService.
  settings    Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users     TenantUser[]
  patients  Patient[]
  locations Location[]
  invites   TenantInvite[]
  refreshSessions RefreshSession[]

  // Lab-side (kind=LAB) connections to clinics that send orders here.
  labLinks    DentalLabClinicLink[] @relation("LabLinks")
  // Clinic-side (kind=CLINIC) connections to labs they place orders with.
  clinicLinks DentalLabClinicLink[] @relation("ClinicLinks")
  // Inverse relations to DentalLabCase (dental lab manufacturing cases).
  labCases     DentalLabCase[] @relation("LabCases")
  clinicCases  DentalLabCase[] @relation("ClinicCases")
  // Invoices issued by this lab vs received by this clinic.
  labInvoices    DentalLabInvoice[] @relation("LabInvoicesLab")
  clinicInvoices DentalLabInvoice[] @relation("LabInvoicesClinic")

  @@index([slug])
  @@index([kind])
  @@map("tenants")
}

// ──────────────────────────────────────────────
// LAB ↔ CLINIC LINKING
// ──────────────────────────────────────────────

// ──────────────────────────────────────────────
// DENTAL LABORATORY (crown & bridge manufacturing marketplace)
// ──────────────────────────────────────────────
//
// These models are the dental-lab side of the product: a clinic sends a case
// to a dental laboratory, which manufactures a prosthetic and invoices for it.
// They are NOT the clinical laboratory. That is LabOrder / LabOrderItem plus
// the LIS models to come, and the two were previously indistinguishable —
// `apps/api/src/lab/` (dental) sat next to `apps/api/src/labs/` (clinical),
// one character apart, with `LabCase` beside `LabOrder`.
//
// The TABLE names deliberately still read `lab_*` rather than `dental_lab_*`.
// Renaming them would leave every RLS policy and index carrying a stale name
// on isolation-critical tables, and two services query these tables through
// raw SQL. The code namespace is where the confusion actually costs time, so
// that is what was renamed; the physical rename can happen on its own later
// without touching application logic.

enum DentalLabClinicLinkStatus {
  PENDING    // lab invited the clinic; awaiting clinic response
  ACTIVE     // both sides connected; orders can flow
  REJECTED   // clinic declined
  REVOKED    // lab cancelled the invitation
  SUSPENDED  // temporarily paused by either side

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabClinicLinkStatus")
}

// Many-to-many between LAB tenants and CLINIC tenants. A lab can have many
// clinic customers; a clinic can place orders with many labs. The pair is
// unique. See docs/lab-module-plan.md for the rationale on
// "free access for associated clinics" — once status=ACTIVE, the linked
// clinic gets the lab-ordering UI even without a paid clinic plan.
model DentalLabClinicLink {
  id              String              @id @default(cuid())
  labTenantId     String
  clinicTenantId  String
  status          DentalLabClinicLinkStatus @default(PENDING)
  // User on the lab side who initiated the invitation.
  invitedByUserId String
  invitedAt       DateTime            @default(now())
  // When the clinic accepted/rejected, or the lab revoked.
  respondedAt     DateTime?
  // Optional message attached to the invitation.
  inviteNote      String?
  // Future: per-clinic price overrides. Null = use lab's default rate card.
  // rateProfileId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lab    Tenant @relation("LabLinks",    fields: [labTenantId],    references: [id], onDelete: Cascade)
  clinic Tenant @relation("ClinicLinks", fields: [clinicTenantId], references: [id], onDelete: Cascade)

  @@unique([labTenantId, clinicTenantId])
  @@index([labTenantId, status])
  @@index([clinicTenantId, status])
  @@map("lab_clinic_links")
}

// ──────────────────────────────────────────────
// LAB PRODUCT CATALOG
// ──────────────────────────────────────────────

// A category/folder in the lab's product catalog. Self-referential for
// nesting (e.g. "Crowns > Zirconia > Anatomical").
model DentalLabProductCategory {
  id          String  @id @default(cuid())
  tenantId    String  // owning lab
  parentId    String?
  name        String
  description String?
  sortOrder   Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent   DentalLabProductCategory?  @relation("LabProductCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children DentalLabProductCategory[] @relation("LabProductCategoryHierarchy")
  products DentalLabProduct[]

  @@index([tenantId, parentId])
  @@map("lab_product_categories")
}

enum DentalLabProductPricingMode {
  // Lab sets a fixed price visible to all customers. Default.
  FIXED
  // Lab sets a price per rate profile (Phase 4 feature). Today this behaves
  // like FIXED with a `defaultPrice` until rate profiles ship.
  PER_RATE_PROFILE
  // No price on the product itself; lab adjusts price when accepting the order.
  ADJUST_ON_ORDER
  // Variable price based on customer's tier. Phase 4.
  VARIABLE_PER_TIER

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabProductPricingMode")
}

// A product (e.g. "Zirconia crown - anatomical"). Each product has an
// optional dynamic form schema captured under `formSchema` and renders
// inside the order request UI.
model DentalLabProduct {
  id           String                 @id @default(cuid())
  tenantId     String                 // owning lab
  categoryId   String?
  sku          String?                // optional internal SKU
  name         String
  description  String?
  // Default price (centavos / minor units). When `pricingMode` is
  // ADJUST_ON_ORDER, this is null and the lab fills in on order intake.
  defaultPrice Int?
  currency     String                 @default("PHP")
  pricingMode  DentalLabProductPricingMode  @default(FIXED)
  // Free-form schema for the dynamic form rendered to the clinic on order.
  // Validated in the service layer; structure is something like:
  // { fields: [{ key, label, type, required, options?: [...] }, ...] }
  formSchema   Json?
  // Deliverable phases (e.g. ["wax-up", "milling", "glazing", "qc"]).
  // Phase 2 ships the manufacturing tracker that consumes this.
  phases       String[]               @default([])
  // Customer-facing tags / filters.
  tags         String[]               @default([])
  isActive     Boolean                @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category            DentalLabProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cases               DentalLabCase[]
  conformityTemplates DentalLabConformityDocTemplate[]
  consentTemplates    DentalLabConsentTemplate[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
  @@map("lab_products")
}

// ──────────────────────────────────────────────
// LAB ORDERS / CASES
// ──────────────────────────────────────────────

enum DentalLabCaseUrgency {
  STANDARD
  URGENT

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabCaseUrgency")
}

enum DentalLabCaseStatus {
  DRAFT             // clinic is composing
  SUBMITTED         // submitted to lab, awaiting review
  IN_PROGRESS       // lab accepted, manufacturing
  AWAITING_PICKUP   // ready for clinic to collect
  SHIPPED           // shipped to clinic
  DELIVERED         // received by clinic
  CANCELLED         // cancelled by either side before completion
  REJECTED          // lab rejected (e.g. files unusable)

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabCaseStatus")
}

enum DentalLabCaseFileStatus {
  PENDING  // S3 PUT not yet confirmed
  READY    // confirmed in S3

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabCaseFileStatus")
}

// A dental-lab case placed by a CLINIC tenant against a LAB tenant.
// (Distinct from the clinical `LabOrder` model used for blood work etc. —
// the dental lab calls these "cases".) Both sides see and mutate the row
// per the transition matrix in apps/api/src/lab/orders/lab-orders.service.ts.
model DentalLabCase {
  id              String         @id @default(cuid())
  // Sequential per-lab reference number (computed at submit time).
  refNumber       Int?
  labTenantId     String
  clinicTenantId  String
  productId       String
  // Snapshot of the price at submit time (centavos). Null when product uses
  // ADJUST_ON_ORDER and the lab hasn't filled in yet.
  unitPrice       Int?
  currency        String         @default("PHP")
  status          DentalLabCaseStatus  @default(DRAFT)
  urgency         DentalLabCaseUrgency @default(STANDARD)
  dueAt           DateTime?
  // Snapshot of the dynamic form data filled in by the clinic.
  formData        Json?
  // Free-text labels from the clinic — we deliberately don't FK to Patient
  // here to avoid cross-tenant joins. The clinic owns its patient mapping.
  patientLabel    String?
  doctorLabel     String?
  deliveryCenter  String?
  notes           String?

  createdByUserId  String
  acceptedByUserId String?

  submittedAt    DateTime?
  acceptedAt     DateTime?
  completedAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product DentalLabProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  lab     Tenant     @relation("LabCases",    fields: [labTenantId],    references: [id], onDelete: Cascade)
  clinic  Tenant     @relation("ClinicCases", fields: [clinicTenantId], references: [id], onDelete: Cascade)

  files          DentalLabCaseFile[]
  phaseEvents    DentalLabCasePhaseEvent[]
  internalNotes  DentalLabCaseNote[]
  messages       DentalLabCaseMessage[]
  tagAssignments    DentalLabCaseTagAssignment[]
  shipment          DentalLabShipment?
  materialUsages    DentalLabMaterialUsage[]
  consentSignatures DentalLabConsentSignature[]
  invoiceItems      DentalLabInvoiceItem[]
  treatmentPlans    DentalLabTreatmentPlan[]
  disputes          DentalLabCaseDispute[]

  @@unique([labTenantId, refNumber])
  @@index([labTenantId, status])
  @@index([clinicTenantId, status])
  @@index([labTenantId, createdAt])
  @@map("lab_cases")
}

// File attachment on a DentalLabCase. Stored in S3 via presigned upload; this row
// is the durable index. Visible to both the lab and the clinic on the
// owning case. The uploader's tenant (lab or clinic) is tracked.
model DentalLabCaseFile {
  id                 String             @id @default(cuid())
  caseId             String
  s3Key              String             @unique
  filename           String
  mimeType           String
  sizeBytes          Int
  uploadedByUserId   String
  uploadedByTenantId String
  status             DentalLabCaseFileStatus  @default(PENDING)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  deletedAt   DateTime?

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("lab_case_files")
}

// ──────────────────────────────────────────────
// LAB MATERIALS / LOT TRACKING (Phase 3)
// ──────────────────────────────────────────────

// A material the lab consumes — e.g. zirconia disc, alloy ingot, ceramic.
// Tenant-owned, free-form category for the lab's own taxonomy.
model DentalLabMaterial {
  id             String  @id @default(cuid())
  tenantId       String
  sku            String?
  name           String
  category       String?
  unitOfMeasure  String  @default("g")   // g, ml, pcs, cc, …
  description    String?
  defaultSupplier String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lots DentalLabMaterialLot[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("lab_materials")
}

enum DentalLabMaterialLotStatus {
  ACTIVE     // currently usable
  WAREHOUSE  // received, not yet opened
  FINISHED   // depleted
  DEFECTIVE  // recalled / rejected
  EXPIRED    // past expiration

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabMaterialLotStatus")
}

// LOT-level traceability. Each receipt of material from a supplier is a row;
// the lab tracks remaining quantity, supplier, manufacturer, and lifecycle
// status. Consumed quantity is computed from DentalLabMaterialUsage rows.
model DentalLabMaterialLot {
  id             String               @id @default(cuid())
  materialId     String
  lotNumber      String
  manufacturer   String?
  supplier       String?
  // Initial quantity received, in the material's UOM.
  initialQty     Float
  // Cached "remaining" — kept up to date by service code on usage write.
  // Floats are fine for centigrams; switch to Decimal if precision matters.
  remainingQty   Float
  unitPriceCents Int?
  receivedAt     DateTime  @default(now())
  expiresAt      DateTime?
  status         DentalLabMaterialLotStatus @default(ACTIVE)
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  material DentalLabMaterial          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  usages   DentalLabMaterialUsage[]

  @@unique([materialId, lotNumber])
  @@index([materialId, status])
  @@index([expiresAt])
  @@map("lab_material_lots")
}

// Material used on a case. Decrements the LOT's remainingQty in the same
// transaction. caseId is denormalized (also reachable via the case) for
// fast per-case rollups.
model DentalLabMaterialUsage {
  id             String   @id @default(cuid())
  caseId         String
  lotId          String
  qty            Float
  usedAt         DateTime @default(now())
  usedByUserId   String

  case DentalLabCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lot  DentalLabMaterialLot @relation(fields: [lotId],  references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([lotId])
  @@map("lab_material_usages")
}

// ──────────────────────────────────────────────
// LAB COMPLIANCE — CONFORMITY + CONSENT (Phase 3)
// ──────────────────────────────────────────────

// Customizable conformity declaration template — typically generated as
// a PDF when the case ships, attesting the manufacturing complies with
// applicable regs (PH FDA / ISO 13485 / etc.). Body is markdown with
// placeholders like {{caseRef}}, {{patient}}, {{lotNumbers}}.
model DentalLabConformityDocTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  // Optional: attach the template to a specific product. Null = generic.
  productId String?
  name      String
  body      String   // markdown with {{placeholders}}
  isDefault Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product DentalLabProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@map("lab_conformity_doc_templates")
}

// Consent template — typically signed by the patient or the clinic on the
// patient's behalf. Same placeholder convention as the conformity template.
model DentalLabConsentTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  productId String?
  name      String
  body      String
  isDefault Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product   DentalLabProduct?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  signatures DentalLabConsentSignature[]

  @@index([tenantId, productId])
  @@map("lab_consent_templates")
}

// A captured signature on a specific case + template. The image lives in
// S3 (signatureFileKey is the object key); IP + timestamp anchor it to a
// session. The clinic captures this on the patient's behalf and signs.
model DentalLabConsentSignature {
  id              String   @id @default(cuid())
  caseId          String
  templateId      String
  signedByName    String
  signedByRole    String?  // e.g. "patient", "guardian", "doctor"
  // S3 object key for the signature image (PNG, transparent bg).
  signatureFileKey String
  ipAddress       String?
  userAgent       String?
  signedAt        DateTime @default(now())
  // Snapshot the template body at sign time so future template edits
  // don't retroactively change what was agreed to.
  bodySnapshot    String

  case     DentalLabCase            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template DentalLabConsentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([templateId])
  @@map("lab_consent_signatures")
}

// ── Disputes ──────────────────────────────────────────────────────
// Either side can open a dispute on a delivered case (e.g. a remake
// request, a quality complaint, a billing disagreement). Disputes carry
// a free-form thread of messages from both sides until one side resolves
// or rejects them.

enum DentalLabCaseDisputeStatus {
  OPEN
  RESOLVED
  REJECTED
  WITHDRAWN

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabCaseDisputeStatus")
}

enum DentalLabCaseDisputeKind {
  QUALITY     // remake / fit / shade complaint
  BILLING     // amount / line-item disagreement
  DELIVERY    // missing items, wrong patient, lost in shipping
  OTHER

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabCaseDisputeKind")
}

model DentalLabCaseDispute {
  id              String                 @id @default(cuid())
  caseId          String
  // Snapshot to avoid joins for RLS predicates.
  labTenantId     String
  clinicTenantId  String
  openedByUserId  String
  openedByTenantId String
  kind            DentalLabCaseDisputeKind     @default(OTHER)
  reason          String
  status          DentalLabCaseDisputeStatus   @default(OPEN)
  resolvedByUserId String?
  resolvedAt       DateTime?
  resolutionNotes  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  case     DentalLabCase                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  messages DentalLabCaseDisputeMessage[]

  @@index([labTenantId, status])
  @@index([clinicTenantId, status])
  @@index([caseId])
  @@map("lab_case_disputes")
}

model DentalLabCaseDisputeMessage {
  id           String    @id @default(cuid())
  disputeId    String
  senderUserId String
  senderTenantId String
  body         String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  dispute DentalLabCaseDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("lab_case_dispute_messages")
}

// ── Treatment plans ────────────────────────────────────────────────
// Lab-proposed treatment plan tied to a DentalLabCase. The lab drafts a plan
// (summary + attached files like STL exports / IPR tables / images), then
// PROPOSES it to the clinic. The clinic approves, rejects, or asks for a
// revision; each decision lands in `DentalLabTreatmentPlanApproval` for an
// audit trail. A case may carry multiple revisions over time — the latest
// non-VOID plan is "active."
//
// RLS: two-sided (same pattern as DentalLabCase / DentalLabInvoice). Lab can write
// plans; clinic can write approvals. Both can read.

enum DentalLabTreatmentPlanStatus {
  DRAFT       // lab is composing
  PROPOSED    // visible to clinic, awaiting decision
  APPROVED
  REJECTED
  REVISION_REQUESTED  // clinic asked for changes; lab can iterate

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabTreatmentPlanStatus")
}

enum DentalLabTreatmentPlanFileKind {
  STL
  IMAGE
  REPORT
  IPR_TABLE
  OTHER

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabTreatmentPlanFileKind")
}

enum DentalLabTreatmentPlanDecision {
  APPROVED
  REJECTED
  REVISION_REQUESTED

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabTreatmentPlanDecision")
}

model DentalLabTreatmentPlan {
  id              String                @id @default(cuid())
  caseId          String
  // Snapshot of the case's lab/clinic at create time so RLS predicates can
  // evaluate without joining (mirrors DentalLabInvoice's pattern).
  labTenantId     String
  clinicTenantId  String
  // Sequential revision number per case (1, 2, 3, …). Allocated when the
  // plan is first PROPOSED.
  revision        Int?
  title           String
  // Markdown summary — the human-readable plan body the clinic decides on.
  summary         String
  status          DentalLabTreatmentPlanStatus @default(DRAFT)
  proposedAt      DateTime?
  decidedAt       DateTime?
  decidedByUserId String?

  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  case        DentalLabCase                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  files       DentalLabTreatmentPlanFile[]
  approvals   DentalLabTreatmentPlanApproval[]

  @@unique([caseId, revision])
  @@index([labTenantId, status])
  @@index([clinicTenantId, status])
  @@index([caseId])
  @@map("lab_treatment_plans")
}

model DentalLabTreatmentPlanFile {
  id          String                  @id @default(cuid())
  planId      String
  s3Key       String
  filename    String
  mimeType    String
  sizeBytes   Int
  kind        DentalLabTreatmentPlanFileKind @default(OTHER)
  uploadedByUserId   String
  uploadedByTenantId String
  createdAt   DateTime                @default(now())
  deletedAt   DateTime?

  plan DentalLabTreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("lab_treatment_plan_files")
}

model DentalLabTreatmentPlanApproval {
  id              String                   @id @default(cuid())
  planId          String
  decision        DentalLabTreatmentPlanDecision
  // The clinic-side user who decided. We track tenant alongside so we can
  // verify (in the service layer) that the actor was on the clinic side.
  decidedByUserId String
  decidedByTenantId String
  notes           String?
  // Snapshot of the plan summary at decision time — keeps the audit
  // immutable even if the lab edits the plan afterwards.
  summarySnapshot String
  decidedAt       DateTime @default(now())

  plan DentalLabTreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("lab_treatment_plan_approvals")
}

// Lab-only note attached to a case. Not visible to the clinic — RLS
// restricts both reads and writes to the case's labTenantId. Soft-deleted
// for an audit trail.
model DentalLabCaseNote {
  id           String    @id @default(cuid())
  caseId       String
  authorUserId String
  body         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("lab_case_notes")
}

// Per-case chat between the lab and the clinic. Both sides can read and
// post. `senderTenantId` records which side wrote the message — the UI
// uses it to align bubbles left/right.
model DentalLabCaseMessage {
  id             String    @id @default(cuid())
  caseId         String
  senderUserId   String
  senderTenantId String
  body           String
  createdAt      DateTime  @default(now())
  // Soft-delete: senders can retract their own messages. Hard-delete reserved
  // for compliance/DSR pipelines.
  deletedAt      DateTime?

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("lab_case_messages")
}

// Lab-owned tag definition. Reusable across cases. Color is a hex string
// without the leading `#` (e.g. "f59e0b") for compact storage.
model DentalLabCaseTag {
  id        String    @id @default(cuid())
  tenantId  String    // owning lab
  name      String
  color     String    @default("64748b") // slate-500
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  assignments DentalLabCaseTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("lab_case_tags")
}

// One shipment per case (1:1). Lab creates when marking SHIPPED; clinic
// (or lab) marks delivered. Carrier + tracking number are free-form so we
// can capture LBC, J&T, JRS, in-house couriers, etc. without a vocabulary.
model DentalLabShipment {
  id             String    @id @default(cuid())
  caseId         String    @unique
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime  @default(now())
  deliveredAt    DateTime?
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("lab_shipments")
}

// ──────────────────────────────────────────────
// LAB BILLING (Phase 4)
// ──────────────────────────────────────────────

enum DentalLabInvoiceStatus {
  DRAFT      // editable, not yet sent to clinic
  ISSUED     // delivered; awaiting payment
  PAID       // settled in full
  OVERDUE    // past dueAt without full payment
  VOID       // cancelled — kept for audit

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabInvoiceStatus")
}

// One invoice from a lab to a clinic. Aggregates one-or-more LabCases via
// DentalLabInvoiceItem rows. Money lives in centavos for tax-safe arithmetic.
model DentalLabInvoice {
  id              String           @id @default(cuid())
  labTenantId     String
  clinicTenantId  String
  // Sequential per-lab number. Allocated when status flips DRAFT → ISSUED.
  refNumber       Int?
  status          DentalLabInvoiceStatus @default(DRAFT)
  currency        String           @default("PHP")
  // Computed columns kept denormalized so list endpoints don't aggregate
  // line items per row. Service layer keeps them in sync on mutation.
  subtotalCents   Int              @default(0)
  taxCents        Int              @default(0)
  totalCents      Int              @default(0)
  paidCents       Int              @default(0)

  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  notes       String?

  // PDF storage — Phase 5 will populate these. For now nullable so the
  // schema matches the future write path without needing another migration.
  pdfFileKey  String?
  pdfFilename String?

  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  lab    Tenant @relation("LabInvoicesLab",    fields: [labTenantId],    references: [id], onDelete: Cascade)
  clinic Tenant @relation("LabInvoicesClinic", fields: [clinicTenantId], references: [id], onDelete: Cascade)

  items        DentalLabInvoiceItem[]
  paymentLinks DentalLabPaymentLink[]

  @@unique([labTenantId, refNumber])
  @@index([labTenantId, status])
  @@index([clinicTenantId, status])
  @@index([dueAt])
  @@map("lab_invoices")
}

// One line on an invoice. May reference a specific DentalLabCase (typical) or be
// freeform (e.g. urgent surcharge, materials passthrough). Once a case is
// referenced from a non-VOID invoice, it should not appear on another to
// avoid double-billing — enforced in service code.
model DentalLabInvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  caseId      String?
  description String
  qty         Int     @default(1)
  unitPriceCents Int
  // qty * unitPriceCents at write time. Stored to avoid floating math.
  amountCents Int
  sortOrder   Int     @default(0)

  invoice DentalLabInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  case    DentalLabCase?   @relation(fields: [caseId],    references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([caseId])
  @@map("lab_invoice_items")
}

enum DentalLabPaymentLinkProvider {
  PAYMONGO
  GCASH
  MAYA
  STRIPE
  MANUAL  // ad-hoc (bank transfer ref, etc.)

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabPaymentLinkProvider")
}

enum DentalLabPaymentLinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabPaymentLinkStatus")
}

// One payment URL per attempt to settle an invoice. We just store the
// provider's URL + external id today — no Phase-4 webhook handling yet.
// When a webhook integration ships, status transitions are wired here.
model DentalLabPaymentLink {
  id          String                  @id @default(cuid())
  invoiceId   String
  provider    DentalLabPaymentLinkProvider  @default(MANUAL)
  externalId  String?
  url         String?
  amountCents Int
  status      DentalLabPaymentLinkStatus    @default(PENDING)
  expiresAt   DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice DentalLabInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
  @@map("lab_payment_links")
}

// M:N between DentalLabCase and DentalLabCaseTag.
model DentalLabCaseTagAssignment {
  caseId         String
  tagId          String
  taggedByUserId String
  taggedAt       DateTime @default(now())

  case DentalLabCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tag  DentalLabCaseTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([caseId, tagId])
  @@index([tagId])
  @@map("lab_case_tag_assignments")
}

// Audit trail of phase transitions per case. The product carries a
// `phases: string[]` (e.g. ["design","milling","glaze","qc"]); a case
// progresses through those phases while in IN_PROGRESS. The current phase
// is the row with `exitedAt = null`. Past phases are kept for the
// manufacturing log and stats.
model DentalLabCasePhaseEvent {
  id              String    @id @default(cuid())
  caseId          String
  phase           String    // matches one entry from DentalLabProduct.phases
  enteredAt       DateTime  @default(now())
  enteredByUserId String
  exitedAt        DateTime?
  notes           String?

  case DentalLabCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, enteredAt])
  // Only one open phase at a time per case is enforced via a partial
  // unique index in the migration (Prisma can't model partial uniques).
  @@map("lab_case_phase_events")
}

enum TenantKind {
  CLINIC
  LAB
}

enum ClinicType {
  GENERAL
  DENTAL
  PEDIATRIC
  DERMATOLOGY
  OBGYN
  CARDIOLOGY
  PSYCH
  OTHER
}

// Lab specialties — used when Tenant.kind = LAB. Loosely modeled on the
// dental-lab market segments (single-craft labs vs. full-service).
enum DentalLabSpecialty {
  CROWN_BRIDGE
  ORTHODONTICS
  IMPLANTOLOGY
  REMOVABLE_PROSTHESIS
  CLEAR_ALIGNERS
  FULL_SERVICE
  OTHER

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabSpecialty")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

// Clinic-side subscription tiers. Feature gating + multi-location caps live
// in libs/shared-types/src/lib/features.ts (PLAN_FEATURES, MAX_LOCATIONS_PER_PLAN).
enum Plan {
  STARTER
  PRO
  PREMIUM
}

// Lab-side subscription tiers. Distinct ladder so we can price labs
// independently of clinics. Feature mapping in
// libs/shared-types/src/lib/features.ts (LAB_PLAN_FEATURES, LAB_PLAN_META).
enum DentalLabPlan {
  LAB_BASIC
  LAB_STANDARD
  LAB_PREMIUM

  // The Postgres type keeps its original name: the dental-lab
  // rename is a code-namespace change, not a database migration.
  @@map("LabPlan")
