// ──────────────────────────────────────────────
// INVENTORY (pharmacy stock + supplies)
// ──────────────────────────────────────────────
//
// Three-table model: catalog (InventoryItem) → batches (StockBatch, lot+expiry)
// → immutable ledger (StockMovement). On-hand qty is derived from
// SUM(batches.remainingQty) so the ledger and balance can never drift.
// FEFO (first-expiry-first-out) is the default dispense order.

model InventoryItem {
  id                   String           @id @default(cuid())
  tenantId             String
  sku                  String
  name                 String
  category             String?
  unit                 String           @default("each")  // tablet, mL, vial, kit, each
  reorderLevel         Int              @default(0)
  defaultPriceCentavos Int              @default(0)
  isControlled         Boolean          @default(false)
  active               Boolean          @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  batches   StockBatch[]
  movements StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId, active, name])
  @@map("inventory_items")
}

model StockBatch {
  id              String    @id @default(cuid())
  tenantId        String
  itemId          String
  lotNumber       String?
  expiresOn       DateTime?
  receivedQty     Int
  remainingQty    Int
  unitCostCentavos Int      @default(0)
  supplierName    String?
  receivedAt      DateTime  @default(now())
  receivedBy      String?

  item      InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  // FEFO indexes — partial: only consider batches with stock left.
  @@index([tenantId, itemId, expiresOn])
  @@index([tenantId, itemId, remainingQty])
  @@map("stock_batches")
}

enum StockMovementKind {
  RECEIVE
  DISPENSE
  ADJUST
  EXPIRE
  RETURN
}

model StockMovement {
  id             String            @id @default(cuid())
  tenantId       String
  itemId         String
  batchId        String?
  kind           StockMovementKind
  quantity       Int               // signed: + receive/return, - dispense/expire/adjust-down
  reason         String?
  prescriptionId String?
  performedBy    String?
  occurredAt     DateTime          @default(now())

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batch StockBatch?   @relation(fields: [batchId], references: [id])

  @@index([tenantId, itemId, occurredAt])
  @@index([tenantId, prescriptionId])
  @@map("stock_movements")
}

// ──────────────────────────────────────────────
// HMO CLAIMS (PH market — Maxicare, Medicard, Intellicare, PhilHealth, …)
// ──────────────────────────────────────────────
//
// Three-table model: catalog (HmoProvider) → patient cards (HmoMembership)
// → submitted claims (HmoClaim). When an HMO approves a claim, recordHmoPayment
// creates a `Payment` row on the linked Invoice with `method=HMO` so the
// existing billing flow recomputes invoice.paidCentavos + status.

model HmoProvider {
  id           String  @id @default(cuid())
  tenantId     String
  name         String
  payerCode    String?  // PhilHealth PHIC code, HMO accreditation no., etc.
  contactPhone String?
  contactEmail String?
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships HmoMembership[]
  claims      HmoClaim[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("hmo_providers")
}

model HmoMembership {
  id          String    @id @default(cuid())
  tenantId    String
  patientId   String
  providerId  String
  memberId    String    // patient's HMO member number / card number
  validFrom   DateTime?
  validUntil  DateTime?
  active      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient  Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider HmoProvider @relation(fields: [providerId], references: [id])
  claims   HmoClaim[]

  @@unique([tenantId, patientId, providerId])
  @@index([tenantId, patientId])
  @@map("hmo_memberships")
}

enum HmoClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIAL
  DENIED
  PAID
  CANCELLED
}

model HmoClaim {
  id                          String         @id @default(cuid())
  tenantId                    String
  invoiceId                   String
  patientId                   String
  providerId                  String
  membershipId                String?
  number                      String         // per-tenant claim number, e.g. CLM-202605-0001
  status                      HmoClaimStatus @default(DRAFT)
  authNumber                  String?        // approval number from the HMO
  claimedCentavos             Int            @default(0)
  approvedCentavos            Int            @default(0)
  patientResponsibilityCentavos Int          @default(0)
  denialReason                String?
  notes                       String?
  submittedAt                 DateTime?
  resolvedAt                  DateTime?
  createdById                 String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patient    Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider   HmoProvider    @relation(fields: [providerId], references: [id])
  membership HmoMembership? @relation(fields: [membershipId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, invoiceId])
  @@index([tenantId, patientId])
  @@map("hmo_claims")
}

// ──────────────────────────────────────────────
// LAB ORDERS + RESULTS
// ──────────────────────────────────────────────
//
// One LabOrder per order slip, multiple LabOrderItems per order (one per
// test). Results are stored inline on the item — for panels that produce
// many values (e.g. CBC), each value gets its own item. Abnormal flags are
// computed at result entry from referenceLow/referenceHigh.

enum LabOrderStatus {
  PENDING
  COLLECTED
  RECEIVED
  REPORTED
  CANCELLED
}

enum LabAbnormalFlag {
  NORMAL
  HIGH
  LOW
  CRITICAL_HIGH
  CRITICAL_LOW
  ABNORMAL
}

model LabOrder {
  id             String         @id @default(cuid())
  tenantId       String
  consultationId String?
  patientId      String
  providerId     String
  number         String         // per-tenant slip number, e.g. LAB-202605-0001
  vendor         String?        // e.g. "Hi-Precision", "Makati Med Lab", in-house
  externalRef    String?        // lab's own reference number
  status         LabOrderStatus @default(PENDING)
  notes          String?

  collectedAt DateTime?
  receivedAt  DateTime?
  reportedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation?  @relation(fields: [consultationId], references: [id])
  items        LabOrderItem[]

  @@unique([tenantId, number])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, consultationId])
  @@map("lab_orders")
}

model LabOrderItem {
  id             String           @id @default(cuid())
  tenantId       String
  orderId        String
  testCode       String?          // e.g. LOINC or local code
  testName       String
  category       String?          // CBC, Chem, Urinalysis, Imaging, …
  resultValue    String?          // free-form: numbers, "Negative", "Reactive"
  resultUnit     String?
  referenceLow   Float?
  referenceHigh  Float?
  abnormalFlag   LabAbnormalFlag?
  comment        String?
  reportedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("lab_order_items")
}

// ──────────────────────────────────────────────
// TELEMEDICINE (WebRTC peer-to-peer)
// ──────────────────────────────────────────────
//
// 1:1 doctor↔patient sessions. Media flows P2P over a public TURN server
// (env-configured); we only relay signaling (offer/answer/ICE) via short-poll
// HTTP — no WebSocket infra needed for MVP. Patient joins via a one-shot
// joinToken so they don't need a portal account.

enum TeleSessionStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

enum TeleSignalKind {
  OFFER
  ANSWER
  ICE
  JOIN
  LEAVE
  CHAT
  CONSENT_REQUEST   // doctor → patient: "may I record this session?"
  CONSENT_RESPONSE  // patient → doctor: { granted: boolean }
}

enum TeleRole {
  DOCTOR
  PATIENT
}

model TeleSession {
  id             String            @id @default(cuid())
  tenantId       String
  appointmentId  String?
  consultationId String?
  patientId      String
  providerId     String
  joinToken      String            // shared with patient via link
  patientToken   String            // bearer for /tele/* signaling after exchange
  status         TeleSessionStatus @default(PENDING)
  startedAt      DateTime?
  endedAt        DateTime?
  // Consent ledger for in-call recording. Both fields stay null when the
  // doctor never asked; recordingConsentAt is set when the patient grants;
  // recordingDeclinedAt is set when refused. Once a recording is uploaded,
  // recordingFileId points at a FileObject. (Recording upload itself is
  // deferred — schema first so the consent flow can ship without ambiguity.)
  recordingConsentAt   DateTime?
  recordingDeclinedAt  DateTime?
  recordingFileId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  signals     TeleSignal[]

  @@unique([tenantId, joinToken])
  @@index([tenantId, status])
  @@index([tenantId, providerId])
  @@map("tele_sessions")
}

model TeleSignal {
  id        String         @id @default(cuid())
  tenantId  String
  sessionId String
  seq       Int
  fromRole  TeleRole
  kind      TeleSignalKind
  payload   Json
  createdAt DateTime       @default(now())

  session TeleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([sessionId, createdAt])
  @@map("tele_signals")
}

// ──────────────────────────────────────────────
// IN-APP NOTIFICATIONS
// ──────────────────────────────────────────────
//
// Per-user, per-tenant feed. Other services call NotificationsService.notify()
// for async events (HMO claim resolved, lab abnormal, low stock, DSR filed,
// reminder fired). Email/SMS remain separate channels — Notification is the
// in-app surface. Severity drives bell badge color.

enum NotificationKind {
  APPOINTMENT_REMINDER
  HMO_CLAIM_UPDATE
  LAB_REPORTED
  LAB_ABNORMAL
  INVENTORY_LOW
  DSR_FILED
  DSR_RESOLVED
  AI_BUDGET_ALERT
  GENERAL
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id        String               @id @default(cuid())
  tenantId  String
  userId    String               // recipient
  kind      NotificationKind
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String?
  link      String?              // optional in-app link, e.g. /admin/claims#<id>
  entityId  String?              // optional FK-shaped pointer (no DB constraint)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([tenantId, userId, readAt, createdAt])
  @@index([tenantId, userId, kind])
  @@map("notifications")
}

// Expo push tokens registered by mobile clients. One row per (user, deviceId)
// — the device id is generated on the client (or derived from Expo's
// installation id) and lets a single user have multiple devices. Tokens are
// dedup'd by (token) globally so a re-install with the same token (Expo can
// re-issue) doesn't accumulate stale rows. Replaced wholesale on each login.
model PushToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  deviceId  String
  token     String   @unique
  platform  String   // 'ios' | 'android' | 'web' | 'unknown'
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([tenantId, userId])
  @@map("push_tokens")
}

// ── Dental / Odontogram ───────────────────────────────────────
// Per-consultation snapshot of the patient's dental chart. A patient can have
// many charts over time; the latest one (by createdAt) is the "current" view.
// Tooth codes use FDI/ISO numbering (11–48 adult permanent, 51–85 deciduous).

enum Dentition {
  ADULT
  DECIDUOUS
  MIXED
}

enum ToothStatus {
  PRESENT
  MISSING
  EXTRACTED
  IMPLANT
  CROWNED
  ROOT_CANAL
  EXTRACTION_NEEDED
  UNERUPTED
}

enum ToothSurface {
  M  // mesial
  O  // occlusal/incisal
  D  // distal
  B  // buccal/facial/labial
  L  // lingual/palatal
}

enum SurfaceFinding {
  CARIES
  RESTORATION_AMALGAM
  RESTORATION_COMPOSITE
  SEALANT
  FRACTURE
  WEAR
}

model DentalChart {
  id             String     @id @default(cuid())
  tenantId       String
  patientId      String
  consultationId String?
  dentition      Dentition  @default(ADULT)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  teeth        DentalToothEntry[]

  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, consultationId])
  @@map("dental_charts")
}

model DentalToothEntry {
  id        String      @id @default(cuid())
  tenantId  String
  chartId   String
  toothCode String      // FDI: "11"-"48" adult, "51"-"85" deciduous
  status    ToothStatus @default(PRESENT)
  notes     String?

  chart    DentalChart            @relation(fields: [chartId], references: [id], onDelete: Cascade)
  surfaces DentalSurfaceFinding[]

  @@unique([chartId, toothCode])
  @@index([tenantId, chartId])
  @@map("dental_tooth_entries")
}

model DentalSurfaceFinding {
  id           String         @id @default(cuid())
  tenantId     String
  toothEntryId String
  surface      ToothSurface
  finding      SurfaceFinding
  notes        String?

  toothEntry DentalToothEntry @relation(fields: [toothEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId, toothEntryId])
  @@map("dental_surface_findings")
}

// ── Delegations / acting-as ──────────────────────────────────
// A doctor (delegator) can grant temporary authority to an assistant
// (delegatee) to act on their behalf within [startsAt, endsAt]. Permission
// checks at runtime override the delegatee's role with the delegator's role
// when the request carries a valid X-Acting-For: <delegatorId> header.
//
// Audit trail records both userId (the actual person) and onBehalfOfUserId
// (the delegator) on every action — so the history reads
// "Maria signed Rx as Dr. Cruz at 14:32".

model Delegation {
  id           String           @id @default(cuid())
  tenantId     String
  delegatorId  String           // the doctor granting authority
  delegateeId  String           // the assistant/secretary receiving it
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  // Empty array = full proxy (delegatee inherits all of the delegator's
  // role permissions). Otherwise: list of Action strings (e.g. "rx:sign")
  // that filters which @Requires() actions are honored under delegation.
  scope        String[]         @default([])
  status       DelegationStatus @default(ACTIVE)
  revokedAt    DateTime?
  revokedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delegator User @relation("DelegationGranter", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegatee User @relation("DelegationGrantee", fields: [delegateeId], references: [id], onDelete: Cascade)

  @@index([tenantId, delegateeId, status, startsAt, endsAt])
  @@index([tenantId, delegatorId, status])
  @@map("delegations")
}

enum DelegationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ── Drug catalog (global, optionally tenant-overridable) ────────────────
// Seeded with common PH drugs (generic + brand). Free-text Rx still permitted
// (drugId is optional) so unusual prescriptions aren't blocked, but the
// autocomplete experience should always start from the catalog.

model Drug {
  id           String     @id @default(cuid())
  // Null tenantId = global / built-in. Non-null = tenant override or custom
  // entry. Lookup query filters: WHERE tenantId IS NULL OR tenantId = :current.
  tenantId     String?
  // Generic INN-style name. "amoxicillin", "paracetamol".
  generic      String
  // Optional brand name. "Amoxil", "Biogesic".
  brand        String?
  // Strength as a string ("500 mg", "250 mg/5 ml") so we don't lose unit
  // semantics. Validation lives in the form.
  strength     String?
  // Dosage form (TAB, CAP, SYRUP, DROPS, etc.). Open string to keep flexible.
  form         String?
  // ATC code if known — anatomical-therapeutic-chemical, used for grouping
  // and interaction checks once we wire those.
  atcCode      String?
  // RxNorm CUI if mapped. Optional, but useful for future interop.
  rxnormCode   String?
  // Free-text classes (e.g. "penicillin", "NSAID") — used for allergy
  // matching at prescribe time when we don't have full ATC coverage.
  classes      String[]   @default([])
  // Whether this is a controlled / dangerous-drug class. UI shows a banner.
  controlled   Boolean    @default(false)
  active       Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptionItems PrescriptionItem[]

  // pg_trgm index defined in migration SQL (Prisma can't express it).
  @@index([tenantId, generic])
  @@index([tenantId, brand])
  @@map("drugs")
}

// ── ICD-10 catalog (global, read-only seed) ─────────────────────────────
// Seeded with WHO ICD-10 codes (subset relevant to PH OPD). Used by the
// consultation diagnosis autocomplete and validated on save.

model IcdCode {
  // The ICD-10 code itself ("J06.9", "I10", etc.) is the natural primary
  // key — no separate id needed, codes are stable.
  code        String   @id
  description String
  // Top-level chapter ("X — Diseases of the respiratory system"). Used for
  // grouping in the UI.
  chapter     String?
  // Whether the code is a "billable" leaf node (vs an aggregate parent).
  // PhilHealth eClaims only accept billable leaves.
  billable    Boolean  @default(true)

  @@index([description])
  @@map("icd_codes")
}

// ── Locations (clinic branches) ─────────────────────────────────────────
// A clinic may operate one or more physical/virtual locations. Most v1
// tenants will have exactly one. Multi-branch UI surfaces this when count > 1.

model Location {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  addressLine1 String?
  addressLine2 String?
  city      String?
  province  String?
  postalCode String?
  country   String   @default("PH")
  phone     String?
  // The "primary" location is the default selected in the UI and the one
  // printed on Rx/invoice headers when no per-location override is set.
  isPrimary Boolean  @default(false)
  active    Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isPrimary])
  @@map("locations")
}
