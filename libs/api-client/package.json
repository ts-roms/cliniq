{
  "name": "@org/api-client",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": ["scope:shared", "type:lib"],
    "targets": {
      "emit-openapi": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/api/dist/main.js --emit-openapi",
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [{ "projects": ["@org/api"], "target": "build" }],
        "outputs": ["{workspaceRoot}/apps/api/openapi.json"],
        "cache": true
      },
      "generate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "openapi-ts",
            "node scripts/strip-js-extensions.mjs"
          ],
          "parallel": false,
          "cwd": "libs/api-client"
        },
        "dependsOn": ["emit-openapi"],
        "outputs": ["{projectRoot}/src/generated"],
        "cache": true
      }
    }
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
