**/node_modules
**/dist
**/build
**/.next
# TS project-reference output + incremental caches. Gitignored, so a clean CI
# checkout never has them — but a dev's working tree does, and copying them in
# lets a stale .d.ts / tsbuildinfo from the host decide what `next build`'s
# typecheck sees. Keep the image building from source only.
**/out-tsc
**/*.tsbuildinfo
**/.expo
**/.turbo
**/storybook-static
**/coverage
**/test-output
**/.cache
**/.nx/cache
**/.nx/workspace-data

# Source-control + editor noise
.git
.github
.vscode
.idea
**/*.log

# Local dotenvs & secrets
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Big media not needed for runtime
**/*.gif
**/*.mp4
docs/
