# Copy to `.env`. Used by both local dev (`pnpm nx serve …`) and the
# docker-compose stack (`docker compose up`). Compose substitutes the values
# below; docker-compose.yml has sensible defaults for everything except
# JWT_SECRET (which it requires).

# ── Postgres (docker-compose) ───────────────────────────────────────
# These configure the postgres container at first boot. The role
# `cliniq_app` is auto-created by docker/postgres-init.sql with password
# `cliniq_app` (matches DATABASE_URL below).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cliniq
POSTGRES_PORT=5432

# ── Database URL ────────────────────────────────────────────────────
# For local non-docker dev: postgres role.
# For docker-compose: the `api` service sets its own URL pointing at the
# `cliniq_app` role (RLS-bound). This var is for `pnpm prisma` from the host.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cliniq?schema=public"

# Optional: app-role URL for running RLS integration tests from the host.
# DATABASE_URL_APP="postgresql://cliniq_app:cliniq_app@localhost:5432/cliniq?schema=public"

# ── JWT / Auth (REQUIRED) ───────────────────────────────────────────
JWT_SECRET="change-me-32-chars-minimum-prod-uses-secrets-manager"
JWT_EXPIRES_IN="15m"
# Refresh tokens are server-side sessions (refresh_sessions table): rotated
# on every use, revoked on logout / suspension / password reset. Keep the
# access TTL short — it is the only window a revoked user keeps.
REFRESH_TOKEN_EXPIRES_IN="7d"

# ── Auth hardening ──────────────────────────────────────────────────
# Lockout: after N failed password/TOTP attempts the account is refused
# for M minutes. Reset on a successful login or a password reset.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
# Staff invite links (POST /members/invites) and reset links.
AUTH_INVITE_TTL_DAYS=7
AUTH_RESET_TTL_MIN=30
# TEST ONLY: return the raw password-reset token in the forgot-password
# response so e2e suites can finish the flow without an inbox. Never set
# where RESEND_API_KEY is configured.
# AUTH_EXPOSE_DEBUG_TOKENS=true

# ── Rate limiting (in-process, per client ip) ───────────────────────
# THROTTLE_LIMIT applies to everything; THROTTLE_AUTH_LIMIT to the
# credential endpoints (login, register, refresh, forgot/reset, tenant
# signup, MFA verify, platform login). Window = THROTTLE_TTL_MS.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
THROTTLE_AUTH_LIMIT=10
# THROTTLE_DISABLED=true   # local load tests only
# Behind ALB / Railway / nginx: honour X-Forwarded-For (hop count or
# express `trust proxy` value). Leave unset when clients hit the api directly.
# TRUST_PROXY=1

# ── ai-service shared secret ────────────────────────────────────────
# The api sends this as X-AI-Service-Token; ai-service refuses calls
# without it. Same value on both. REQUIRED when ai-service runs with
# NODE_ENV=production (it refuses to boot otherwise). Generate:
#   openssl rand -hex 32
AI_SERVICE_TOKEN=""

# ── Service ports (docker-compose host port mappings) ───────────────
API_PORT=4000
AI_PORT=4100
WEB_PORT=3000

# ── Frontend ────────────────────────────────────────────────────────
# Web (Next.js) — baked into the client bundle at build time. Point at the
# api host:port from the *browser's* perspective (not the container network).
NEXT_PUBLIC_API_URL=http://localhost:4000
PORTAL_BASE_URL=http://localhost:3000

# Mobile (Expo) — only used outside docker-compose; mobile doesn't run in the
# stack. Set when running `expo start` against this api.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000

# CORS allow-list for the api (comma-separated). Defaults in main.ts already
# include the Next.js web app and Expo web (8081/19000/19006). Override here
# in prod or when serving Expo web from a different port.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000,http://localhost:19006
#
# Note: Expo loads env from `apps/mobile/.env*` (CWD of `expo start`), not from
# this workspace-root file. If you hit "Body is unusable: Body has already been
# read" at startup, that's an @expo/cli@54.0.24 bug — copy or create
# `apps/mobile/.env.local` containing `EXPO_NO_DEPENDENCY_VALIDATION=1`.

# ── AWS / Bedrock (for AI features) ─────────────────────────────────
# Leave blank to use the stub-fallback in ai-service.
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_SOAP=""
BEDROCK_MODEL_DERM=""

# ── S3 (PHI bucket) ─────────────────────────────────────────────────
S3_BUCKET_PHI=""
S3_BUCKET_PUBLIC=""

# ── Email (Resend) — no-op when blank ───────────────────────────────
RESEND_API_KEY=""
MAIL_FROM="ClinIQ <noreply@cliniq.local>"

# ── SMS — no-op when blank. Pick semaphore (PH) or twilio. ──────────
SMS_PROVIDER=""
SEMAPHORE_API_KEY=""
SMS_SENDER_NAME="CLINIQ"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ── Telemedicine TURN ───────────────────────────────────────────────
# Leave blank for LAN/STUN-only (works on the same network only).
# In production point at coturn or Twilio TURN.
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ── Appointments reminder loop ──────────────────────────────────────
APPT_REMINDERS_ENABLED=false
APPT_REMINDER_INTERVAL_MS=300000
APPT_REMINDER_LEAD_MINUTES=60

# ── Files janitor — keep OFF in dev so we never touch real buckets ──
JANITOR_ENABLED=false
ORPHAN_MAX_AGE_MIN=60
RETAIN_DELETED_DAYS=90
